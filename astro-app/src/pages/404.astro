---
import PageHero from "@/components/sites/kashtoken/page-hero.astro"
import { buttonVariants } from "@/components/ui/button"
import Layout from "@/layouts/main.astro"
---

<Layout title="Page not found" noindex>
  <PageHero slot="hero" heading="Page not found" />
  <div class="space-y-6 text-[14.667px] text-ink-soft">
    <p>The page you are looking for does not exist or has moved.</p>
    <a href="/" class={buttonVariants({ size: "lg" })}>Back to home</a>
  </div>
</Layout>
