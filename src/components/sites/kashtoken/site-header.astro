---
import { Image } from "astro:assets"

import logo from "@/assets/kashtoken/logo.png"
import type { NavNode } from "@/lib/nav"

import SiteNav from "./site-nav"

interface Props {
  tree: NavNode
}

const { tree } = Astro.props
---

<header class="absolute inset-x-0 top-0 z-20 flex h-14 items-center gap-3 bg-brand-navy px-4 text-white">
  <a href="/" class="flex items-center gap-3" aria-label="KASH home">
    <Image src={logo} alt="" width={56} height={56} class="size-14" loading="eager" />
    <span class="hidden font-display text-[26.667px] md:inline">KASH</span>
  </a>
  <SiteNav client:load tree={tree} />
</header>
