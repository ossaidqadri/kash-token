---
import { getEntry, render } from "astro:content"

import HomeHero from "@/components/sites/kashtoken/home-hero.astro"
import Prose from "@/components/sites/kashtoken/prose.astro"
import Layout from "@/layouts/main.astro"

const page = await getEntry("pages", "home")
if (!page) throw new Error("missing `home` page entry")
const { Content } = await render(page)
---

<Layout description={page.data.description}>
  <HomeHero slot="hero" />
  <Prose><Content /></Prose>
</Layout>
